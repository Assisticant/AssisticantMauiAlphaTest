<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Scoped to this project only. The machine-wide NuGet.Config has an internal,
    VPN-only package source configured that isn't reachable in this environment,
    so <clear/> resets to just nuget.org plus the GitHub Packages feed hosting
    the Assisticant alpha packages.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="assisticant-alpha" value="https://nuget.pkg.github.com/michaellperry/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <assisticant-alpha>
      <add key="Username" value="michaellperry" />
      <add key="ClearTextPassword" value="%GH_PACKAGES_TOKEN%" />
    </assisticant-alpha>
  </packageSourceCredentials>
</configuration>
