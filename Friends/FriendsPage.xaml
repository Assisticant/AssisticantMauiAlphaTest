<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:friends="clr-namespace:AssisticantMauiAlphaTest.Friends"
             x:Class="AssisticantMauiAlphaTest.Friends.FriendsPage"
             x:DataType="friends:FriendListViewModel"
             Title="Friends">

    <Grid RowDefinitions="*,Auto" Padding="16" RowSpacing="12">
        <CollectionView Grid.Row="0" ItemsSource="{Binding Friends}">
            <CollectionView.EmptyView>
                <Label Text="No friends yet. Add one below."
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="friends:FriendViewModel">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Padding="0,8">
                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                            <Label Text="{Binding Name}" FontSize="18" />
                            <Label Text="{Binding Age, StringFormat='Age {0}'}" TextColor="Gray" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="Edit" Clicked="OnEditClicked" />
                        <Button Grid.Column="2" Text="Remove" Clicked="OnRemoveClicked" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="1" Text="Add friend" Clicked="OnAddClicked" />
    </Grid>

</ContentPage>
